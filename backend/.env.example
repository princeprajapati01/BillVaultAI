# Database Configurations
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=aura_idp

# Security Configurations
# Generate a strong 64+ char key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & Network Configurations
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SEED_DEFAULT_USERS=false

# SMTP Configurations for Email OTP
# For Gmail: Set SMTP_HOST to smtp.gmail.com and SMTP_PORT to 587
# SMTP_PASS: Use an App Password (Google Account -> Security -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=your_email@gmail.com

# Google Gemini (Free tier on https://aistudio.google.com) - Recommended
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Local Vision-Language Model (Ollama) Configurations (Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120

